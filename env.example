# Paper2Product AI (free/local-first)
#
# This project uses a local Python service for generation + evaluation.
# You can run it with Oumi (local inference engines) or fall back to Ollama.

# Where Next.js calls the local service
OUMI_SERVICE_URL=http://127.0.0.1:8001

# Optional: shared secret between Vercel (Next.js) and your deployed Python service
# If set on the service, set the same value on Vercel.
OUMI_SERVICE_TOKEN=change_me_to_a_long_random_string

# How much PDF text to send to the local service (cost/speed control)
MAX_EXTRACT_CHARS=18000

# (Optional) If you want the service to use Ollama (free local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# (Optional) If you want the service to use OpenAI (hosted, fast)
# If OPENAI_API_KEY is set, the service will prefer OpenAI over Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # optional (OpenAI-compatible providers)
OPENAI_TIMEOUT_SEC=60

# Ollama can be slow on CPU for long prompts; increase timeout for demo
OLLAMA_TIMEOUT_SEC=600

# To speed up the demo, you can disable evaluation (cuts one LLM call)
ENABLE_EVAL=0

# Extra speed controls for CPU demos
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.2

# (Optional) Oumi local inference settings (Python service)
# OUMI_ENGINE=native            # HuggingFace transformers
# OUMI_MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct
# OUMI_ENGINE=llamacpp          # llama.cpp GGUF
# OUMI_GGUF_PATH=path/to/model.gguf